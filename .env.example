# Discord bot token. Create your application at https://discord.com/developers/applications
DISCORD_TOKEN=

# OpenAI API key (moderation endpoint is documented as free to use).
OPENAI_API_KEY=

# OpenRouter API key (the Nemotron :free model has provider/platform quotas).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Local mode defaults to ./data/bombamod.db (SQLite). For durable hosting, set a
# PostgreSQL URL, e.g. postgresql+asyncpg://user:password@host:5432/bombamod
DATABASE_URL=

# Optional: sync global slash commands to one development guild immediately.
# Leave blank to sync globally (new global commands can take time to appear).
DISCORD_GUILD_ID=

# Resource bounds. Use small values for free-tier worker instances.
MAX_CONCURRENT_MODERATION=4
HTTP_TIMEOUT_SECONDS=12
MAX_IMAGE_BYTES=8000000
MAX_MESSAGE_CHARS=6000
IMAGE_SCAN_ENABLED_BY_DEFAULT=false

# Hard privacy gate: OpenRouter never gets text unless this host-level setting
# AND per-server /bm privacy opt-in are both true. Keep false unless operators
# have reviewed the additional privacy/retention tradeoff.
ALLOW_OPENROUTER_TEXT=false

# Discord message content is sent to OpenAI for classification on enabled servers.
# A strict global gate is available to run without external text classification.
# Enabling this gate causes all moderated messages to be escalated for manual review.
DISABLE_OPENAI_TEXT=false
LOG_LEVEL=INFO
